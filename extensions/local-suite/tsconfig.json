{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react",
    "strict": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "esModuleInterop": true,
    "lib": ["ES2020", "DOM"],
    "paths": {
      "spotifyplus": ["./node_modules/spotifyplus/dist/index.d.ts"],
      "spotifyplus/react": ["./node_modules/spotifyplus/dist/components.d.ts"]
    }
  },
  "include": ["apps/**/*.tsx", "shared/**/*.ts", "shared/**/*.tsx"]
}
